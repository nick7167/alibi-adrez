{
  "name": "aha-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "vars": {
    "ALLOWED_ORIGINS": "https://aha.adrez.dev,capacitor://localhost"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS_DO", "class_name": "RoomDurableObject" }]
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATE_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "ROOM_ACCESS_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }]
}
